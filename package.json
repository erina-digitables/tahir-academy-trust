{
  "name": "tahir-academy-trust",
  "version": "1.0.0",
  "private": true,
  "description": "Tahir Academy Trust — static marketing site for the Enfield/Cheshunt Islamic education charity.",
  "scripts": {
    "css": "tailwindcss -i ./src/input.css -o ./assets/css/site.css",
    "build:css": "npm run css -- --minify",
    "watch:css": "npm run css -- --watch",
    "images": "node scripts/optimise-images.js",
    "build": "npm run images && npm run build:css",
    "serve": "node scripts/serve.js",
    "dev": "node scripts/dev.js"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  }
}
