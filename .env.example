# Copy to .env and fill in. .env is gitignored and must never be committed.

# Stitch MCP — used only by stitch-proxy.js when re-importing designs.
# Get a key from the Stitch console. The proxy refuses to start without it.
STITCH_API_KEY=your-stitch-api-key-here

# Optional. Defaults to https://stitch.googleapis.com/mcp
STITCH_MCP_URL=https://stitch.googleapis.com/mcp
